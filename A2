import java.util.Scanner;
public class A2 {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int [n];
        for(int i=0;i<arr.length;i++){
            arr[i]=sc.nextInt();
        }
     int l=arr[0];
        for(int i=1;i<arr.length;i++){
            if(arr[i]>l){
                l=arr[i];
            }
        }
        System.out.println(l);
    }
}
