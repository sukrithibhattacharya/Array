import java.util.Scanner;

public class A8 {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int [n];
        for(int i=0;i<arr.length;i++){
            arr[i]=sc.nextInt();
        }
          int x=sc.nextInt();
        int count=0;
    for(int i=0;i<arr.length;i++){
        if(x==arr[i]){
            count++;
        }
    }
        System.out.println(count);
        
    }
}
