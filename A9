import java.util.Scanner;

public class A9 {
    public static void main(String[] args) {
       Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int [n];
        for(int i=0;i<arr.length;i++){
            arr[i]=sc.nextInt();
        }
          int x=sc.nextInt();
        boolean found=false;
    for(int i=0;i<arr.length;i++){
        if(x==arr[i]){
           found=true;
            break;
        }
        
    }
        if(found){
            System.out.println("YES");
        }
        else{
               System.out.println("NO");
        }
        
        
    }
}
