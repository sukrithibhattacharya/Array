        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];
        int brr[] = new int[n];

        for(int i = 0; i < n; i++){
            arr[i] = sc.nextInt();
        }

        for(int i = 0; i < n; i++){
            brr[i] = sc.nextInt();
        }

        if(Arrays.equals(arr, brr)){
            System.out.println("True");
        } else {
            System.out.println("False");
        }
